# Copy to .env and adjust. Never commit .env.
# Defaults match compose.yaml; when running the API on the host, point at localhost.

POSTGRES_USER=larder
POSTGRES_PASSWORD=larder
POSTGRES_DB=larder

# API
DATABASE_URL=postgresql+asyncpg://larder:larder@localhost:5432/larder
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000"]

# Tests that need Postgres (database is created if missing; tests skip if unreachable)
TEST_DATABASE_URL=postgresql+asyncpg://larder:larder@localhost:5432/larder_test

# Data pipeline: TheMealDB key ("1" is the free development key)
MEALDB_API_KEY=1

# Clerk (auth). Create a free development instance at https://dashboard.clerk.com and copy
# its API keys here. The API derives the token issuer from the publishable key.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Web (server-side calls to the API)
API_URL=http://localhost:8000
