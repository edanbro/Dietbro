# Copy to .env and adjust. Never commit .env.
# Defaults match compose.yaml; when running the API on the host, point at localhost.

POSTGRES_USER=larder
POSTGRES_PASSWORD=larder
POSTGRES_DB=larder

# API
DATABASE_URL=postgresql+asyncpg://larder:larder@localhost:5432/larder
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000"]

# Tests that need Postgres (database is created if missing; tests skip if unreachable)
TEST_DATABASE_URL=postgresql+asyncpg://larder:larder@localhost:5432/larder_test

# Data pipeline: TheMealDB key ("1" is the free development key)
MEALDB_API_KEY=1

# Clerk (auth). Create a free development instance at https://dashboard.clerk.com and copy
# its API keys into .env (never here: this file is committed). The API derives the token
# issuer from the publishable key.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Chat (LLM layer). Optional: without a key the chat runs offline (rule parser and templated
# replies, same plan changes). Get one at https://console.anthropic.com and put it in .env only.
ANTHROPIC_API_KEY=
# LLM_MODE=offline            # force offline even with a key
# LLM_MONTHLY_CAP_USD=1.0     # per user; LLM_DAILY_MESSAGES=60

# Receipt intake (worker reads photos with offline OCR; no key needed). Per-user limits:
# RECEIPT_DAILY_UPLOADS=20      # photos + pasted receipts per rolling 24 h
# RECEIPT_MAX_IMAGE_BYTES=8000000

# Barcode scanning: products not imported yet are looked up on Open Food Facts, which asks for
# a User-Agent naming the app and a contact (only the barcode is sent). Leave empty to look up
# imported products only.
# OFF_USER_AGENT=Mealwright/0.1 (you@example.com)

# Expiry reminders (Web Push). Optional: generate a key pair with `uv run larder-vapid` and
# paste both lines into .env (never here). VAPID_SUBJECT is a contact for push services.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Web (server-side calls to the API)
API_URL=http://localhost:8000
