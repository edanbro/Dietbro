  "components": {
    "schemas": {
      "Activity": {
        "type": "string",
        "enum": [
          "sedentary",
          "light",
          "moderate",
          "active",
          "very_active"
        ],
        "title": "Activity"
      },
      "Allergen": {
        "type": "string",
        "enum": [
          "celery",
          "gluten",
          "crustaceans",
          "eggs",
          "fish",
          "lupin",
          "milk",
          "molluscs",
          "mustard",
          "tree_nuts",
          "peanuts",
          "sesame",
          "soy",
          "sulphites"
        ],
        "title": "Allergen"
      },
      "AllergenOption": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/Allergen"
          },
          "label": {
            "type": "string",
            "title": "Label"
          }
        },
        "type": "object",
        "required": [
          "code",
          "label"
        ],
        "title": "AllergenOption"
      },
      "AllergiesIn": {
        "properties": {
          "allergens": {
            "items": {
              "$ref": "#/components/schemas/Allergen"
            },
            "type": "array",
            "title": "Allergens"
          },
          "avoid_food_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Avoid Food Ids"
          }
        },
        "type": "object",
        "title": "AllergiesIn"
      },
      "AllergiesOut": {
        "properties": {
          "allergens": {
            "items": {
              "$ref": "#/components/schemas/Allergen"
            },
            "type": "array",
            "title": "Allergens"
          },
          "avoid_food_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Avoid Food Ids"
          },
          "avoid_foods": {
            "items": {
              "$ref": "#/components/schemas/FoodSummary"
            },
            "type": "array",
            "title": "Avoid Foods"
          }
        },
        "type": "object",
        "title": "AllergiesOut"
      },
      "BodyIn": {
        "properties": {
          "sex": {
            "$ref": "#/components/schemas/Sex"
          },
          "age": {
            "type": "integer",
            "maximum": 130.0,
            "minimum": 0.0,
            "title": "Age"
          },
          "height_cm": {
            "type": "number",
            "maximum": 300.0,
            "exclusiveMinimum": 0.0,
            "title": "Height Cm"
          },
          "weight_kg": {
            "type": "number",
            "maximum": 500.0,
            "exclusiveMinimum": 0.0,
            "title": "Weight Kg"
          },
          "activity": {
            "$ref": "#/components/schemas/Activity"
          }
        },
        "type": "object",
        "required": [
          "sex",
          "age",
          "height_cm",
          "weight_kg",
          "activity"
        ],
        "title": "BodyIn"
      },
      "BodyOut": {
        "properties": {
          "sex": {
            "$ref": "#/components/schemas/Sex"
          },
          "age": {
            "type": "integer",
            "maximum": 130.0,
            "minimum": 0.0,
            "title": "Age"
          },
          "height_cm": {
            "type": "number",
            "maximum": 300.0,
            "exclusiveMinimum": 0.0,
            "title": "Height Cm"
          },
          "weight_kg": {
            "type": "number",
            "maximum": 500.0,
            "exclusiveMinimum": 0.0,
            "title": "Weight Kg"
          },
          "activity": {
            "$ref": "#/components/schemas/Activity"
          },
          "tdee_kcal": {
            "type": "number",
            "title": "Tdee Kcal"
          },
          "suggestions": {
            "additionalProperties": {
              "$ref": "#/components/schemas/SuggestedTargets"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/Goal"
            },
            "type": "object",
            "title": "Suggestions"
          }
        },
        "type": "object",
        "required": [
          "sex",
          "age",
          "height_cm",
          "weight_kg",
          "activity",
          "tdee_kcal",
          "suggestions"
        ],
        "title": "BodyOut"
      },
      "FoodDetail": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "kcal": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kcal"
          },
          "units": {
            "items": {
              "$ref": "#/components/schemas/FoodUnit"
            },
            "type": "array",
            "title": "Units"
          }
        },
        "type": "object",
        "required": [
          "id",
          "description",
          "category",
          "kcal",
          "units"
        ],
        "title": "FoodDetail"
      },
      "FoodSummary": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "kcal": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kcal"
          }
        },
        "type": "object",
        "required": [
          "id",
          "description",
          "category",
          "kcal"
        ],
        "title": "FoodSummary"
      },
      "FoodUnit": {
        "properties": {
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "grams_each": {
            "anyOf": [
