      "text": "{\"id\":956,\"name\":\"Chicken tikka masala with rice\",\"category\":\"Chicken\",\"cuisine\":\"Indian\",\"image_url\":null,\"minutes\":40,\"instructions\":\"Fry the chopped onion in the oil, add the chicken and garam masala and cook for 8 minutes.\\nAdd the tomatoes and simmer for 20 minutes, then stir in the cream.\\nServe with the rice, boiled for 12 minutes.\",\"generated\":false,\"source\":\"curated\",\"source_url\":null,\"servings\":4,\"servings_estimated\":false,\"per_serving\":{\"kcal\":576,\"protein_g\":42,\"fat_g\":14,\"carbs_g\":70,\"fiber_g\":4.6,\"sugars_g\":5.9,\"sat_fat_g\":3.9,\"salt_g\":0.5,\"iron_mg\":4.78,\"calcium_mg\":104.97,\"potassium_mg\":910.54,\"vitamin_c_mg\":16.88,\"vitamin_d_ug\":0.28,\"folate_ug\":323.56,\"vitamin_b12_ug\":0.35},\"cost_per_serving\":206,\"currency\":\"EUR\",\"grade\":\"A\",\"meal_types\":[\"lunch\",\"dinner\"],\"allergens\":[\"celery\",\"milk\",\"mustard\"],\"allergens_complete\":true,\"suitable_for\":[],\"ingredients\":[{\"name\":\"onion\",\"measure\":\"2\",\"food_id\":170000,\"food_name\":\"Onions, raw\",\"grams\":220.0,\"in_pantry\":false},{\"name\":\"vegetable oil\",\"measure\":\"1 tbsp\",\"food_id\":172336,\"food_name\":\"Oil, canola\",\"grams\":13.625,\"in_pantry\":false},{\"name\":\"chicken breast\",\"measure\":\"600g\",\"food_id\":171077,\"food_name\":\"Chicken, broiler or fryers, breast, skinless, boneless, meat only, raw\",\"grams\":600.0,\"in_pantry\":true},{\"name\":\"garam masala\",\"measure\":\"1 tbsp\",\"food_id\":170924,\"food_name\":\"Spices, curry powder\",\"grams\":6.15,\"in_pantry\":false},{\"name\":\"tinned tomato\",\"measure\":\"400g\",\"food_id\":170051,\"food_name\":\"Tomatoes, red, ripe, canned, packed in tomato juice\",\"grams\":400.0,\"in_pantry\":false},{\"name\":\"single cream\",\"measure\":\"100ml\",\"food_id\":170857,\"food_name\":\"Cream, fluid, light (coffee cream or table cream)\",\"grams\":100.0,\"in_pantry\":false},{\"name\":\"basmati rice\",\"measure\":\"300g\",\"food_i