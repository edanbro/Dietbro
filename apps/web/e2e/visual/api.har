      "text": "{\"id\":649,\"name\":\"Spanish Chicken\",\"category\":\"Chicken\",\"cuisine\":\"Spanish\",\"image_url\":\"https://www.themealdb.com/images/media/meals/pqulvm1763282839.jpg\",\"minutes\":45,\"instructions\":\"step 1\\r\\nHeat oven to 190C/170C fan/gas 5. Put all the ingredients into a large, wide ovenproof dish. Mix everything together with your hands and season.\\r\\n\\r\\nstep 2\\r\\nBake for 45 mins, stirring the onions after 20 mins, until the chicken is golden and the onions tender. Serve with rice.\",\"generated\":false,\"source\":\"mealdb\",\"source_url\":\"https://www.bbcgoodfood.com/recipes/spanish-chicken\",\"servings\":3,\"servings_estimated\":true,\"per_serving\":{\"kcal\":590,\"protein_g\":82,\"fat_g\":22,\"carbs_g\":14,\"fiber_g\":2.7,\"sugars_g\":5.7,\"sat_fat_g\":5.2,\"salt_g\":1.2,\"iron_mg\":4.53,\"calcium_mg\":72.12,\"potassium_mg\":1265.72,\"vitamin_c_mg\":21.91,\"vitamin_d_ug\":0.0,\"folate_ug\":55.31,\"vitamin_b12_ug\":2.42},\"cost_per_serving\":343,\"currency\":\"EUR\",\"grade\":\"A\",\"meal_types\":[\"lunch\",\"dinner\"],\"allergens\":[\"celery\"],\"allergens_complete\":true,\"suitable_for\":[],\"ingredients\":[{\"name\":\"Chicken Thighs\",\"measure\":\"8\",\"food_id\":173627,\"food_name\":\"Chicken, broilers or fryers, dark meat, thigh, meat only, raw\",\"grams\":1192.0,\"in_pantry\":false},{\"name\":\"Onion\",\"measure\":\"3 sliced thinly\",\"food_id\":170000,\"food_name\":\"Onions, raw\",\"grams\":330.0,\"in_pantry\":false},{\"name\":\"Paprika\",\"measure\":\"2 teaspoons\",\"food_id\":171329,\"food_name\":\"Spices, paprika\",\"grams\":4.566666666666666,\"in_pantry\":false},{\"name\":\"Lemon\",\"measure\":\"Zest and juice of 1\",\"food_id\":167746,\"food_name\":\"Lemons, raw, without peel\",\"grams\":2.0,\"in_pantry\":false},{\"name\":\"Parsley\",\"measure\":\"Handful\",\"food_id\":170416,\"food_name\":\"Parsley, fresh\",\"grams\":30.0,\"in_pantry\":false},{\"name\":\"Chicken Stock\",\"measure\":\"150ml\",\"food_id\":172884,\"